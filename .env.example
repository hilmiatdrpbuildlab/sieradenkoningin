# Copy to .env for local development. Every service falls back to a mock adapter when its key is empty.

# Database — local fallback cluster (see docs/RUNBOOK.md) or a Neon pooled URL.
DATABASE_URL=postgres://sk@localhost:54329/sieradenkoningin
# Separate database used by `npm run test` integration tests
TEST_DATABASE_URL=postgres://sk@localhost:54329/sieradenkoningin_test

# Public site URL (decision D8: domain still OPEN)
PUBLIC_SITE_URL=http://localhost:5173
# Public/CDN base for media. Empty → files served by the dev mock from /media
PUBLIC_MEDIA_URL=

# Sessions & 2FA
SESSION_SECRET=change-me-32-bytes-minimum-random-string
# 32 bytes, base64 — `node -e "console.log(crypto.randomBytes(32).toString('base64'))"`
TOTP_ENC_KEY=

# Object storage (S3-compatible; D7). Empty → mock adapter writing to .data/uploads
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto

# Payments (Mollie, D1). Empty → mock adapter with "simulate paid/failed" page
MOLLIE_API_KEY=
# Shipping (Sendcloud, D2). Empty → mock labels + tracking
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
# Email (Postmark, D5). Empty → mock writes .data/emails/*.html
POSTMARK_TOKEN=
EMAIL_FROM=Sieradenkoningin <hallo@example.invalid>
SHOP_INBOX=shop@example.invalid
# Newsletter (Brevo, D5). Empty → mock
BREVO_API_KEY=
BREVO_LIST_ID=
# Cloudflare Turnstile. Empty → always passes (dev only)
TURNSTILE_SECRET=
PUBLIC_TURNSTILE_SITE_KEY=
# Analytics (P4-05)
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_GA4_ID=
# Sentry (P5-04)
SENTRY_DSN=
# Cron/queue endpoint protection
CRON_SECRET=change-me
# Seed
SEED_ADMIN_EMAIL=owner@example.invalid
