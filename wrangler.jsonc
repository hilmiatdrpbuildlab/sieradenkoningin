{
	// Cloudflare Workers config (adapter-cloudflare 8). Secrets: `wrangler secret put <NAME>`
	// (DATABASE_URL, SESSION_SECRET, TOTP_ENC_KEY, STORAGE_*, MOLLIE_API_KEY, SENDCLOUD_*, POSTMARK_TOKEN,
	//  BREVO_*, TURNSTILE_SECRET, CRON_SECRET, SENTRY_DSN). See docs/RUNBOOK.md.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sieradenkoningin",
	"main": "cloudflare/worker.js",
	"compatibility_date": "2026-10-07",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	// Cron trigger: cloudflare/worker.js `scheduled()` POSTs /api/jobs with CRON_SECRET (P5-04): every 5 min →
	// release expired reservations + queued jobs; the 05:00 UTC tick also runs the daily report + cleanup
	// (one trigger: Workers Free allows 5 crons per account).
	"triggers": { "crons": ["*/5 * * * *"] },
	"vars": {
		"PUBLIC_SITE_URL": "https://sieradenkoningin.goosebumpsevents.workers.dev",
		// Staging/demo deploy: noindex + staging notice. Remove (or set "") for the live launch.
		"PUBLIC_STAGING": "1"
	}
}
