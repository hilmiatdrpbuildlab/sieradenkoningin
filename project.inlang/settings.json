{
	"$schema": "https://inlang.com/schema/project-settings",
	"baseLocale": "nl",
	"locales": [
		"nl",
		"fr"
	],
	"modules": [
		"https://cdn.jsdelivr.net/npm/@inlang/plugin-message-format@4/dist/index.js"
	],
	"plugin.inlang.messageFormat": {
		"pathPattern": [
			"./messages/core/{locale}.json",
			"./messages/shop/{locale}.json",
			"./messages/catalog/{locale}.json",
			"./messages/cart/{locale}.json",
			"./messages/checkout/{locale}.json",
			"./messages/account/{locale}.json",
			"./messages/content/{locale}.json",
			"./messages/email/{locale}.json"
		]
	}
}
