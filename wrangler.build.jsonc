{
	// Used ONLY by @sveltejs/adapter-cloudflare at build time (see vite.config.ts → adapter({ config })).
	// The adapter writes the generated worker to `main`; deployment uses wrangler.jsonc, whose `main`
	// (cloudflare/worker.js) wraps this generated worker and adds the Cron `scheduled` handler.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sieradenkoningin",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-07",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" }
}
