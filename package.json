{
	"name": "sieradenkoningin",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"prepare": "svelte-kit sync || echo \"\"",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --experimental-strip-types scripts/migrate.ts",
		"db:seed": "node --experimental-strip-types scripts/seed.ts",
		"db:studio": "drizzle-kit studio",
		"pretest": "svelte-kit sync"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.26.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.3",
		"vitest": "^5.0.3",
		"wrangler": "^4.148.0"
	},
	"dependencies": {
		"@fontsource-variable/montserrat": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource/allura": "^5.3.0",
		"aws4fetch": "^1.0.20",
		"drizzle-orm": "^0.45.3",
		"hash-wasm": "^4.12.0",
		"pdf-lib": "^1.17.1",
		"pg": "^8.23.1",
		"zod": "^4.6.5"
	}
}
